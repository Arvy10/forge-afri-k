# --- Supabase (Project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique (anon / publishable) : peut aller dans le navigateur, la RLS protège les données.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SERVEUR UNIQUEMENT. Ne jamais la préfixer par NEXT_PUBLIC_.
# Sert uniquement à inviter des membres (action réservée à l'admin).
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# URL publique du site (sans slash final) : utilisée dans les liens d'invitation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
