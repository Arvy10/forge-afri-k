# --- Supabase (Project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique (anon / publishable). Le navigateur n'en a besoin que pour envoyer un fichier
# vers une URL signée par le serveur : elle ne peut lire AUCUNE table pc_*.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SERVEUR UNIQUEMENT. Ne jamais la préfixer par NEXT_PUBLIC_.
# C'est la seule clé qui lit et écrit les données.
SUPABASE_SERVICE_ROLE_KEY=

# --- Accès au site (aucun compte e-mail) ---
# Code d'accès COMMUN à tout le pôle. Peut être changé ensuite depuis « Réglages » (alors stocké haché en base).
ACCESS_CODE=
# Code du MODE ADMINISTRATEUR, connu du seul ambassadeur.
ADMIN_CODE=
# Secret qui signe les cookies de session (32 caractères minimum, aléatoire).
# Générer : openssl rand -base64 48
SESSION_SECRET=
